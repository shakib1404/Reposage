# ─────────────────────────────────────────────────────────────────────────────
#  RepoSage — production environment
#  Copy to `.env` on the server and fill in. Never commit the filled-in file.
#     cp deploy.env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the site is served ────────────────────────────────────────────────
# ":80"          → plain HTTP on the droplet's IP (fine to start with)
# "reposage.me"  → Caddy automatically issues + renews a Let's Encrypt cert.
#                  Point the domain's A record at the droplet IP FIRST,
#                  otherwise the certificate request fails.
SITE_ADDRESS=:80

# Only needed if you serve the frontend from a different origin than the API
# (the default Docker setup does not — leave blank).
CORS_ALLOW_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. The free M0 tier is enough.
# In Atlas → Network Access, allow the droplet's IP (or 0.0.0.0/0 if you
# must, but prefer the specific IP).
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/reposage

# Signing key for login tokens. Generate a fresh one for production:
#     openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── LLM (Groq) ──────────────────────────────────────────────────────────────
# At least _1 is required; the rest are fallbacks used on rate-limit/error.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-120b

# ── Repo search ─────────────────────────────────────────────────────────────
# GitHub token lifts the API limit from 60 to 5000 requests/hour. A classic
# token with NO scopes ticked is sufficient — search only reads public data.
GITHUB_TOKEN=
SERPER_API_KEY=
JINA_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
USE_MOCK=false

# Optional: outgoing mail (password reset). Leave blank to disable.
GMAIL_USER=
GMAIL_PASS=
