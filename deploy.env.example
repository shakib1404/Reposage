# ─────────────────────────────────────────────────────────────────────────────
#  RepoSage — production environment
#  Copy to `.env` on the server and fill in. Never commit the filled-in file.
#     cp deploy.env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the site is served ────────────────────────────────────────────────
# ":80"          → plain HTTP on the droplet's IP (fine to start with)
# "reposage.me"  → Caddy automatically issues + renews a Let's Encrypt cert.
#                  Point the domain's A record at the droplet IP FIRST,
#                  otherwise the certificate request fails.
SITE_ADDRESS=:80

# Only needed if you serve the frontend from a different origin than the API
# (the default Docker setup does not — leave blank).
CORS_ALLOW_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. The free M0 tier is enough.
# In Atlas → Network Access, allow the droplet's IP (or 0.0.0.0/0 if you
# must, but prefer the specific IP).
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/reposage

# Signing key for login tokens. Generate a fresh one for production:
#     openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── LLM (Groq) ──────────────────────────────────────────────────────────────
# At least _1 is required; the rest are fallbacks used on rate-limit/error.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Primary model. Keys 1-4 are all tried on it before anything else.
GROQ_MODEL=openai/gpt-oss-120b

# Groq meters tokens PER MODEL, so when every key is out of daily quota on the
# primary, switching model buys a fresh allowance. Leave this unset to use the
# built-in chain (gpt-oss-120b → gpt-oss-20b → qwen3.8-27b → gpt-oss-safeguard-20b)
# with GROQ_MODEL promoted to the front. Set it to override the chain entirely.
# Verify any id against /v1/models first: most of Groq's catalogue 404s on the
# free tier.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# ── Repo search ─────────────────────────────────────────────────────────────
# GitHub token lifts the API limit from 60 to 5000 requests/hour. A classic
# token with NO scopes ticked is sufficient — search only reads public data.
GITHUB_TOKEN=
SERPER_API_KEY=
JINA_API_KEY=

# ── Running from Docker Hub images ──────────────────────────────────────────
# Only needed with docker-compose.hub.yml, which pulls pre-built images
# instead of building on the server (the build needs more RAM than a small
# droplet has). Set to the Docker Hub account the images were pushed to.
DOCKERHUB_USER=
# Which published tag to run. Pin a version rather than tracking "latest" so a
# bad push doesn't roll out on the next restart.
TAG=v1

# ── RepoTask Executor (step 8) ──────────────────────────────────────────────
# This one agent drives Claude directly rather than Groq, so it needs its own
# key. It also pushes a branch and opens a PR, which the search-only
# GITHUB_TOKEN above cannot do.
#
# Put these here OR in "repo-task executor/.env" — compose reads both, and
# neither file is ever copied into the image. Leave blank to disable step 8.
#
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
#
# NOTE: the GITHUB_TOKEN above is reused for the push/PR. For that it needs
# more than the search-only "no scopes" token described earlier — a classic
# token with the `repo` scope, or a fine-grained token with Contents:write
# AND Pull requests:write on the target repos.

# ── Misc ────────────────────────────────────────────────────────────────────
USE_MOCK=false

# Optional: outgoing mail (password reset). Leave blank to disable.
GMAIL_USER=
GMAIL_PASS=
