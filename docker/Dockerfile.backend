# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
#  RepoSage backend — FastAPI + the repo execution/audit engine
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.13-slim

# System packages the app shells out to at RUNTIME (not just build time):
#   git              — executor.py / tester.py clone every repo
#                      they analyse; without it the whole pipeline dies at
#                      step 1 with a confusing "git: not found"
#   build-essential  — analysed repos frequently have deps with C extensions
#                      that compile during their pip install
#   ca-certificates  — TLS to Groq, GitHub, HuggingFace, Serper, Jina
#   xvfb + tk        — analysed repos are often desktop apps. pygame and Qt can
#                      be forced offscreen with env vars, but tkinter cannot:
#                      it needs a real X display or it dies on
#                      "no display name and no $DISPLAY". xvfb-run gives it a
#                      throwaway one, so a GUI repo runs its actual code path
#                      instead of being reported as broken.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
        ca-certificates \
        curl \
        xvfb \
        xauth \
        tk \
    && rm -rf /var/lib/apt/lists/*

# PIP_NO_CACHE_DIR is deliberately NOT set here. It keeps the image small, but
# an ENV applies at RUN time too, and at run time the audit creates a fresh venv
# per repo and pip-installs seven scanners (ruff, bandit, pip-audit, mypy,
# detect-secrets, vulture, semgrep — ~465MB) into it. With the cache disabled
# every audit re-downloads all of it from PyPI: measured 56.4s, against 10.6s
# once a cache is warm. Note that PIP_NO_CACHE_DIR=0 does NOT re-enable it —
# pip reads any value as true — so the variable has to be absent, and the build
# layers below pass --no-cache-dir explicitly instead.
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/opt/hf \
    SENTENCE_TRANSFORMERS_HOME=/opt/hf

WORKDIR /app

# CPU-only torch, installed FIRST and from PyTorch's dedicated CPU index.
#
# sentence-transformers depends on torch. Left to resolve torch on its own,
# pip installs the default CUDA build: ~1.2GB of torch plus ~2.7GB of
# nvidia/* CUDA libraries and ~700MB of triton — none of which this app ever
# touches, since it only runs MiniLM / cross-encoder inference and always on
# CPU (verified: no `.to(device)` or cuda call anywhere in backend/). Pinning
# the CPU wheel up front makes the requirements install below a no-op for
# torch and takes the image from ~5GB down to well under 1.5GB — the
# difference between needing an expensive droplet and a cheap one.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# The RepoTask Executor is a separate agent package that main.py launches as a
# subprocess. It is NOT under backend/, so the `COPY backend/ /app/` below does
# not pick it up — without this the feature dies with
#     can't open file '/repo-task executor/run_task.py'
# Its deps are installed here, next to the backend's, so they share a layer.
COPY ["repo-task executor/requirements.txt", "/tmp/rte-requirements.txt"]
# pytest is not in that file, but the agent's TestRunner needs it: its Docker
# path runs `pip install pytest` inside a throwaway container, and this image
# has no Docker CLI, so it always takes the LOCAL fallback — which installs
# nothing. Without pytest here the agent applies its fix correctly and then
# reports FAILED because it cannot run the tests that would prove the fix.
RUN pip install --no-cache-dir -r /tmp/rte-requirements.txt pytest \
    && rm /tmp/rte-requirements.txt

# Bake the two sentence-transformers models search.py loads into the image.
# Downloading them lazily on the first search costs ~10s of user-visible
# latency and fails outright if HuggingFace is unreachable from the host.
RUN python -c "\
from sentence_transformers import SentenceTransformer, CrossEncoder;\
SentenceTransformer('all-MiniLM-L6-v2');\
CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')" \
    && chmod -R a+rX /opt/hf

COPY backend/ /app/

# Space in the source path, so the JSON form of COPY is required. Lands
# outside /app deliberately: it is a sibling package, not part of the API.
COPY ["repo-task executor/", "/opt/repo-task-executor/"]

# The agent commits its fix to a local branch in the throwaway workspace.
# A fresh container has no git identity, so `git commit` aborted with
#     fatal: unable to auto-detect email address ... Author identity unknown
# straight after the tests had already passed. Env vars rather than a
# .gitconfig so this holds whatever HOME the process ends up with.
ENV GIT_AUTHOR_NAME="RepoSage Agent" \
    GIT_AUTHOR_EMAIL="agent@reposage.local" \
    GIT_COMMITTER_NAME="RepoSage Agent" \
    GIT_COMMITTER_EMAIL="agent@reposage.local"

# This container runs code from arbitrary public repositories, so the app runs
# as an unprivileged user and writes only under /data (a volume) and /tmp.
#
# The entrypoint starts as root just long enough to fix /data's ownership (a
# platform volume mounts over it root-owned) and then drops to `reposage` —
# see docker/entrypoint.sh. Without it a volume is unwritable for that user.
RUN useradd --create-home --uid 10001 reposage \
    && mkdir -p /data/outputs /data/outputs/taskexec /data/corpus \
    && chown -R reposage:reposage /app /data /opt/repo-task-executor
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

ENV EXECUTOR_OUTPUT_ROOT=/data/outputs \
    CORPUS_ROOT=/data/corpus

EXPOSE 8000

# --workers 1 is deliberate: the reranker model is held in process memory and
# a second worker would double the ~500MB resident footprint for no gain —
# this workload is I/O- and subprocess-bound, not request-throughput-bound.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
